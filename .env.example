# Herald Angel example configuration
#
# Copy this file to .env and fill in your private values.
#
# Do not commit your real .env file.
# Do not publish Discord tokens, Twitch secrets, databases, logs, or backups.

# ---------------------------------------------------------------------
# Required Discord settings
# ---------------------------------------------------------------------

# Your Discord bot token.
# Keep this private.
DISCORD_TOKEN=

# Your Discord user ID.
# Owner-only commands are checked against this ID.
OWNER_ID=0

# ---------------------------------------------------------------------
# Bot identity and command safety
# ---------------------------------------------------------------------

HERALD_NAME=Herald Angel
HERALD_COMMAND_PREFIX=herald

# Recommended self-host defaults:
# - Owner controls Herald through DMs.
# - Server text commands are disabled by default.
HERALD_DM_COMMANDS_ENABLED=true
HERALD_OWNER_ONLY=true
HERALD_REPLY_TO_NON_OWNER_DMS=false
HERALD_SERVER_COMMANDS_ENABLED=false

# ---------------------------------------------------------------------
# Welcome and Discord channels
# ---------------------------------------------------------------------

WELCOME_ENABLED=true
WELCOME_CHANNEL_NAME=welcome
SUBSCRIPTIONS_CHANNEL_NAME=subscriptions

FREE_GAMES_CHANNEL_NAME=free-games
GPU_UPDATES_CHANNEL_NAME=gpu-updates
STREAM_ALERTS_CHANNEL_NAME=stream-alerts
SECURITY_ALERTS_CHANNEL_NAME=security-alerts

# ---------------------------------------------------------------------
# Local database
# ---------------------------------------------------------------------

HERALD_DB_PATH=./data/herald.db

# ---------------------------------------------------------------------
# Emoji / presentation
# ---------------------------------------------------------------------

# Unicode defaults are safest for public/self-host installs.
# You may replace these in your private .env with custom Discord emoji.
HERALD_EMOJI_HERALD=🎺
HERALD_EMOJI_FREE_GAME=🎮
HERALD_EMOJI_GCARD=🖥️
HERALD_EMOJI_SECURITY=🛡️

# ---------------------------------------------------------------------
# Watcher settings
# ---------------------------------------------------------------------

HERALD_AUTO_POST_ENABLED=true

# Public-friendly default: once per hour.
# Choose a reasonable interval for the providers you use.
HERALD_CHECK_SECONDS=3600

# First-start discovered items are held for review by default.
HERALD_STARTUP_BACKLOG_MODE=held

HERALD_POST_BATCH_LIMIT=10
HERALD_DELIVERY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------
# Free game watcher
# ---------------------------------------------------------------------

GAMERPOWER_API_URL=https://www.gamerpower.com/api/giveaways
GAMERPOWER_RSS_URL=https://www.gamerpower.com/rss/giveaways
HERALD_FREE_GAME_STRICT_FILTER=true

# ---------------------------------------------------------------------
# GPU update watcher
# ---------------------------------------------------------------------

GURU3D_RSS_URL=https://www.guru3d.com/rss.xml

# ---------------------------------------------------------------------
# Security RSS watcher
# ---------------------------------------------------------------------

SECURITY_RSS_URLS=https://www.cisa.gov/cybersecurity-advisories/all.xml,https://www.bleepingcomputer.com/feed/,https://www.ncsc.gov.uk/api/1/services/v1/all-rss-feed.xml
HERALD_SECURITY_STRICT_FILTER=true

# ---------------------------------------------------------------------
# Twitch live stream watcher
# ---------------------------------------------------------------------

# Twitch alerts are optional and disabled by default.
# To enable them, create a Twitch Developer app, then fill in:
# - TWITCH_CLIENT_ID
# - TWITCH_CLIENT_SECRET
# - TWITCH_CHANNELS
TWITCH_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch login names, for example:
# TWITCH_CHANNELS=examplechannel,anotherchannel
TWITCH_CHANNELS=

TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
TWITCH_STREAMS_URL=https://api.twitch.tv/helix/streams
TWITCH_USER_AGENT=Herald Angel Twitch Watcher

# If enabled, Herald may ping the configured stream alert role.
# The bot code only allows the configured role, not arbitrary role mentions.
TWITCH_PING_ROLE_ENABLED=true
TWITCH_PING_ROLE_NAME=Stream Alerts