# RottenLabz Herald v1.0.1 configuration template.
# Create the REAL .env as 0600 before editing secrets; see docs/INSTALL.md.
# Public placeholders only. No database, credentials, private feeds or plugins.
DISCORD_TOKEN=
OWNER_ID=0
HERALD_GUILD_ID=0

# Brand is RottenLabz Herald; everyday bot/display name is Herald.
HERALD_NAME=Herald
HERALD_COMMAND_PREFIX=herald
HERALD_COMMAND_SCOPE=guild
HERALD_BUILD_ID=
HERALD_DM_COMMANDS_ENABLED=true
HERALD_SERVER_COMMANDS_ENABLED=false
HERALD_REPLY_TO_NON_OWNER_DMS=false
# HERALD_OWNER_ONLY is deprecated; privileged actions are always owner-only.

WELCOME_ENABLED=true
WELCOME_CHANNEL_ID=0
WELCOME_CHANNEL_NAME=welcome
SUBSCRIPTIONS_CHANNEL_ID=0
SUBSCRIPTIONS_CHANNEL_NAME=subscriptions

# Development paths. For systemd use /var/lib/rottenlabz-herald/{herald.db,feeds.json}.
HERALD_DB_PATH=./data/herald.db
HERALD_FEED_CONFIG_PATH=./data/feeds.json
# Optional trusted local extensions only; see docs/CONFIGURATION.md.
HERALD_PRIVATE_PROVIDERS=[]

HERALD_EMOJI_HERALD=🎺
HERALD_EMOJI_WELCOME=👋
HERALD_EMOJI_FREE_GAME=🎮
HERALD_AUTO_POST_ENABLED=true
HERALD_CHECK_SECONDS=3600
HERALD_DELIVERY_SECONDS=15
HERALD_STARTUP_BACKLOG_MODE=held
HERALD_POST_BATCH_LIMIT=10
HERALD_DELIVERY_MAX_ATTEMPTS=5

# Sole built-in content provider. Destination ID must be configured.
FREE_GAMES_ENABLED=true
FREE_GAMES_CHANNEL_ID=0
FREE_GAMES_ROLE_ID=0
FREE_GAMES_DELIVERY_MODE=automatic
# GamerPower API is primary; RSS fallback is opt-in and disabled by default.
HERALD_GAMERPOWER_RSS_FALLBACK_ENABLED=false
HERALD_FREE_GAME_STRICT_FILTER=true
# Configure operator-authorized generic feeds through /herald feed.
