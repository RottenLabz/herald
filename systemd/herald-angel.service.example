[Unit]
Description=Herald Angel Discord watcher bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=herald
Group=herald
WorkingDirectory=/opt/herald-angel
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/herald-angel/.venv/bin/python /opt/herald-angel/bot.py
Restart=on-failure
RestartSec=10

# Basic hardening. Adjust if your deployment needs more access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/herald-angel/data /opt/herald-angel/logs /opt/herald-angel/backups

[Install]
WantedBy=multi-user.target
